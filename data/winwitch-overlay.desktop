[Desktop Entry]
Type=Application
Name=WinWitch Overlay
Name[zh_CN]=WinWitch 浮层
Comment=WinWitch overlay; shows the available letters in selection mode
Comment[zh_CN]=WinWitch 的浮层（选择模式时显示可用字母）
# @WRAPPER@ 由 scripts/install.sh 在安装时替换为真实路径。
Exec=@WRAPPER@
Icon=preferences-system-windows
Terminal=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
