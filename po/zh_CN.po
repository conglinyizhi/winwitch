# ---- 外观 ----
msgid "Appearance"
msgstr "外观"

msgid "Overlay position"
msgstr "浮层位置"

msgid "Bottom center"
msgstr "屏幕底部居中"

msgid "Screen center"
msgstr "屏幕中央"

msgid "Top center"
msgstr "屏幕顶部居中"

msgid "Maximum columns"
msgstr "最多列数"

msgid "Show window title"
msgstr "显示窗口标题"

msgid "Show the window title under the app name"
msgstr "在应用名下面显示窗口标题"

msgid "Background style"
msgstr "背景风格"

